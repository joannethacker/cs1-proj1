modules = ["java-graalvm22.3", "nix"]
run = "echo 'Please use the Shell tab to run your programs:' && echo '  javac Project1.java && java Project1'"

[nix]
channel = "stable-25_05"

[languages.java]
pattern = "**/*.java"

[languages.java.languageServer]
start = "jdt-language-server -data /tmp/jdtls-workspace"
